---
// The How it works diagram. Two variants of the same content, both built from the strings of the
// page's locale (src/i18n/<locale>.ts) so they translate: a wide drawing (an inline SVG, from
// final/diagram-c8.svg) and, under 1100 px, a stacked variant in HTML and CSS with the same colors.
// The styling is V1 of the round 3 mockups (specs/carried-context-site/mockups-v3/): boxes on paper with
// 3 unit corners and an ink-soft outline, clay connectors, mono eyebrows, and the agent as a prompt
// chevron in an ink ring; each engineer's coding agent is the same glyph, small, in clay. The geometry,
// the connectors' coordinates and dash patterns and the agent's ring are those the drawing script in
// HomePage.astro reads, so a change there needs a look at the script.
// The wide drawing's boxes are fixed width, so keep translated labels close to the English length. At
// 1100 px and above the drawing scales to no less than 0.94, so its smallest text (13 units) renders
// at 12 px or more. The stacked variant joins its three groups with bars, as the drawing's connectors
// do: the inputs to the agent, the agent to the outputs, and the last output to the engineers. CSS
// shows one variant at a time, so only one is in the accessibility tree. Both carry the same aria-label.
import { getStrings } from '../i18n';

interface Props {
  locale?: string;
}
const d = getStrings(Astro.props.locale).diagram;
---

<div class="flow">
  <svg class='flow-wide' viewBox='0 0 1100 400' xmlns='http://www.w3.org/2000/svg' role='img' aria-label={d.ariaLabel}><text class='up' x='0' y='16' text-anchor='start' font-size='13' font-weight='600' fill='var(--ink-soft)'>{d.provideHeading}</text><text class='up' x='600' y='16' text-anchor='start' font-size='13' font-weight='600' fill='var(--ink-soft)'>{d.generatesHeading}</text><rect x='0' y='40' width='282' height='72' rx='3' fill='var(--paper)' stroke='var(--ink-soft)' stroke-width='1.2'/><text x='16' y='73.0' text-anchor='start' font-size='15' font-weight='600' fill='var(--ink)'>{d.documents}</text><text x='16' y='94.0' text-anchor='start' font-size='13' font-weight='400' fill='var(--ink-soft)'>{d.documentsNote}</text><line class='ln' x1='282' y1='76' x2='330' y2='76' stroke-width='1.6'/><rect x='0' y='136' width='282' height='72' rx='3' fill='var(--paper)' stroke='var(--ink-soft)' stroke-width='1.2'/><text x='16' y='169.0' text-anchor='start' font-size='15' font-weight='600' fill='var(--ink)'>{d.decisions}</text><text x='16' y='190.0' text-anchor='start' font-size='13' font-weight='400' fill='var(--ink-soft)'>{d.decisionsNote}</text><line class='ln' x1='282' y1='172' x2='330' y2='172' stroke-width='1.6'/><rect x='0' y='300' width='282' height='72' rx='3' fill='var(--paper)' stroke='var(--ink-soft)' stroke-width='1.2' stroke-dasharray="5 5"/><text x='16' y='320' text-anchor='start' font-size='13' font-weight='600' class='eb up'>{d.later}</text><text x='16' y='342' text-anchor='start' font-size='15' font-weight='600' fill='var(--ink)'>{d.changed}</text><text x='16' y='361' text-anchor='start' font-size='13' font-weight='400' fill='var(--ink-soft)'>{d.changedNote}</text><line class='ln' x1='282' y1='336' x2='330' y2='336' stroke-width='1.6' stroke-dasharray="5 5"/><line class='ln' x1='330' y1='76' x2='330' y2='200' stroke-width='1.6'/><line class='ln' x1='330' y1='200' x2='330' y2='336' stroke-width='1.6' stroke-dasharray="5 5"/><line class='ln' x1='330' y1='200' x2='392' y2='200' stroke-width='1.6'/><text x='450' y='128' text-anchor='middle' font-size='15' font-weight='700' fill='var(--ink)'>{d.agent}</text><circle cx='450' cy='200' r='58' fill='var(--paper)' class='tk' stroke-width='1.6'/><path class='pr' d='M430.2 184.6 L447.8 200 L430.2 215.4' fill='none' stroke='var(--ink)' stroke-width='4.84' stroke-linecap='round' stroke-linejoin='round'/><path class='pr' d='M454.4 217.6 H474.2' fill='none' stroke='var(--ink)' stroke-width='4.84' stroke-linecap='round'/><text x='450' y='290' text-anchor='middle' font-size='13' font-weight='400' fill='var(--ink)'>{d.agentVerbs[0]}</text><text x='450' y='308' text-anchor='middle' font-size='13' font-weight='400' fill='var(--ink)'>{d.agentVerbs[1]}</text><line class='ln' x1='508' y1='200' x2='580' y2='200' stroke-width='1.6'/><line class='ln' x1='580' y1='70' x2='580' y2='334' stroke-width='1.6'/><line class='ln' x1='580' y1='70' x2='600' y2='70' stroke-width='1.6'/><rect x='600' y='34' width='330' height='72' rx='3' fill='var(--paper)' stroke='var(--ink-soft)' stroke-width='1.2'/><text x='616' y='54' text-anchor='start' font-size='13' font-weight='600' class='eb up'>{d.plans}</text><text x='616' y='76' text-anchor='start' font-size='15' font-weight='600' fill='var(--ink)'>{d.plansTitle}</text><text x='616' y='95' text-anchor='start' font-size='13' font-weight='400' fill='var(--ink-soft)'>{d.plansNote}</text><line class='ln' x1='580' y1='158' x2='600' y2='158' stroke-width='1.6'/><rect x='600' y='122' width='330' height='72' rx='3' fill='var(--paper)' stroke='var(--ink-soft)' stroke-width='1.2'/><text x='616' y='142' text-anchor='start' font-size='13' font-weight='600' class='eb up'>{d.writes}</text><text x='616' y='164' text-anchor='start' font-size='15' font-weight='600' fill='var(--ink)'>{d.writesTitle}</text><text x='616' y='183' text-anchor='start' font-size='13' font-weight='400' fill='var(--ink-soft)'>{d.writesNote}</text><line class='ln' x1='580' y1='246' x2='600' y2='246' stroke-width='1.6'/><rect x='600' y='210' width='330' height='72' rx='3' fill='var(--paper)' stroke='var(--ink-soft)' stroke-width='1.2'/><text x='616' y='230' text-anchor='start' font-size='13' font-weight='600' class='eb up'>{d.opens}</text><text x='616' y='252' text-anchor='start' font-size='15' font-weight='600' fill='var(--ink)'>{d.opensTitle}</text><text x='616' y='271' text-anchor='start' font-size='13' font-weight='400' fill='var(--ink-soft)'>{d.opensNote}</text><line class='ln' x1='580' y1='334' x2='600' y2='334' stroke-width='1.6'/><rect x='600' y='298' width='330' height='72' rx='3' fill='var(--paper)' stroke='var(--ink-soft)' stroke-width='1.2'/><text x='616' y='318' text-anchor='start' font-size='13' font-weight='600' class='eb up'>{d.generates}</text><text x='616' y='340' text-anchor='start' font-size='15' font-weight='600' fill='var(--ink)'>{d.generatesTitle}</text><text x='616' y='359' text-anchor='start' font-size='13' font-weight='400' fill='var(--ink-soft)'>{d.generatesNote}</text><text class='up' x='1016' y='254' text-anchor='middle' font-size='13' font-weight='600' fill='var(--ink-soft)'>{d.engineers[0]}</text><text class='up' x='1016' y='270' text-anchor='middle' font-size='13' font-weight='600' fill='var(--ink-soft)'>{d.engineers[1]}</text><line class='ln' x1='930' y1='334' x2='966' y2='334' stroke-width='1.6'/><line class='ln' x1='966' y1='296' x2='966' y2='372' stroke-width='1.6'/><line class='ln' x1='966' y1='296' x2='992' y2='296' stroke-width='1.6'/><circle cx='1006' cy='296' r='14' fill='var(--paper)' stroke='var(--ink)' stroke-width='1.4'/><circle cx='1006' cy='292' r='4.5' fill='var(--ink)'/><path d='M998 306 a8 7 0 0 1 16 0 z' fill='var(--ink)'/><circle cx='1038' cy='296' r='11' fill='var(--paper)' class='tk tk-s' stroke-width='1.4'/><path class='pr' d='M1032.6 291.8 L1037.4 296 L1032.6 300.2' fill='none' stroke='var(--clay)' stroke-width='1.32' stroke-linecap='round' stroke-linejoin='round'/><path class='pr' d='M1039.2 300.8 H1044.6' fill='none' stroke='var(--clay)' stroke-width='1.32' stroke-linecap='round'/><line class='ln' x1='966' y1='334' x2='992' y2='334' stroke-width='1.6'/><circle cx='1006' cy='334' r='14' fill='var(--paper)' stroke='var(--ink)' stroke-width='1.4'/><circle cx='1006' cy='330' r='4.5' fill='var(--ink)'/><path d='M998 344 a8 7 0 0 1 16 0 z' fill='var(--ink)'/><circle cx='1038' cy='334' r='11' fill='var(--paper)' class='tk tk-s' stroke-width='1.4'/><path class='pr' d='M1032.6 329.8 L1037.4 334 L1032.6 338.2' fill='none' stroke='var(--clay)' stroke-width='1.32' stroke-linecap='round' stroke-linejoin='round'/><path class='pr' d='M1039.2 338.8 H1044.6' fill='none' stroke='var(--clay)' stroke-width='1.32' stroke-linecap='round'/><line class='ln' x1='966' y1='372' x2='992' y2='372' stroke-width='1.6'/><circle cx='1006' cy='372' r='14' fill='var(--paper)' stroke='var(--ink)' stroke-width='1.4'/><circle cx='1006' cy='368' r='4.5' fill='var(--ink)'/><path d='M998 382 a8 7 0 0 1 16 0 z' fill='var(--ink)'/><circle cx='1038' cy='372' r='11' fill='var(--paper)' class='tk tk-s' stroke-width='1.4'/><path class='pr' d='M1032.6 367.8 L1037.4 372 L1032.6 376.2' fill='none' stroke='var(--clay)' stroke-width='1.32' stroke-linecap='round' stroke-linejoin='round'/><path class='pr' d='M1039.2 376.8 H1044.6' fill='none' stroke='var(--clay)' stroke-width='1.32' stroke-linecap='round'/></svg>
  <div class="flow-stack" role="img" aria-label={d.ariaLabel}>
    <div class="fs-group">
      <p class="fs-heading">{d.provideHeading}</p>
      <div class="fs-card"><strong>{d.documents}</strong><span>{d.documentsNote}</span></div>
      <div class="fs-card"><strong>{d.decisions}</strong><span>{d.decisionsNote}</span></div>
      <div class="fs-card fs-later"><em>{d.later}</em><strong>{d.changed}</strong><span>{d.changedNote}</span></div>
    </div>
    <div class="fs-link" aria-hidden="true"></div>
    <div class="fs-group fs-agent">
      <svg viewBox="392 142 116 116" width="96" height="96" aria-hidden="true" focusable="false">
        <circle cx='450' cy='200' r='58' fill='var(--paper)' class='tk' stroke-width='1.6'/><path class='pr' d='M430.2 184.6 L447.8 200 L430.2 215.4' fill='none' stroke='var(--ink)' stroke-width='4.84' stroke-linecap='round' stroke-linejoin='round'/><path class='pr' d='M454.4 217.6 H474.2' fill='none' stroke='var(--ink)' stroke-width='4.84' stroke-linecap='round'/>
      </svg>
      <p class="fs-agent-name">{d.agent}</p>
      <p class="fs-verbs">{d.agentVerbs[0]} {d.agentVerbs[1]}</p>
    </div>
    <div class="fs-link" aria-hidden="true"></div>
    <div class="fs-group">
      <p class="fs-heading">{d.generatesHeading}</p>
      <div class="fs-card"><em>{d.plans}</em><strong>{d.plansTitle}</strong><span>{d.plansNote}</span></div>
      <div class="fs-card"><em>{d.writes}</em><strong>{d.writesTitle}</strong><span>{d.writesNote}</span></div>
      <div class="fs-card"><em>{d.opens}</em><strong>{d.opensTitle}</strong><span>{d.opensNote}</span></div>
      <div class="fs-card"><em>{d.generates}</em><strong>{d.generatesTitle}</strong><span>{d.generatesNote}</span></div>
      <div class="fs-link" aria-hidden="true"></div>
      <p class="fs-heading fs-engineers">{d.engineers[0]} {d.engineers[1]}</p>
      <div class="fs-people">
        {[0, 1, 2].map(() => (
          <svg viewBox="992 281 60 30" width="60" height="30" aria-hidden="true" focusable="false">
            <circle cx='1006' cy='296' r='14' fill='var(--paper)' stroke='var(--ink)' stroke-width='1.4'/><circle cx='1006' cy='292' r='4.5' fill='var(--ink)'/><path d='M998 306 a8 7 0 0 1 16 0 z' fill='var(--ink)'/><circle cx='1038' cy='296' r='11' fill='var(--paper)' class='tk tk-s' stroke-width='1.4'/><path class='pr' d='M1032.6 291.8 L1037.4 296 L1032.6 300.2' fill='none' stroke='var(--clay)' stroke-width='1.32' stroke-linecap='round' stroke-linejoin='round'/><path class='pr' d='M1039.2 300.8 H1044.6' fill='none' stroke='var(--clay)' stroke-width='1.32' stroke-linecap='round'/>
          </svg>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .flow {
    max-width: 1100px;
    margin: 0 auto;
  }
  .flow-wide {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-body);
  }
  .flow-stack {
    display: none;
  }
  /* Headings and eyebrows: mono capitals. The headings in ink soft, the eyebrows in clay ink. */
  .flow-wide .up,
  .fs-heading,
  .fs-card em {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .flow-wide .eb {
    fill: var(--clay-ink);
  }
  /* The connectors in clay; the agent's ring in ink; the engineers' agents ringed in clay. */
  .flow-wide .ln {
    stroke: var(--clay);
    fill: none;
  }
  .tk {
    stroke: var(--ink);
  }
  .tk.tk-s {
    stroke: var(--clay);
  }
  /* Letter spacing and capitals mean nothing in Chinese and Japanese. */
  :global(html:lang(ja)) .flow-wide .up,
  :global(html:lang(zh-CN)) .flow-wide .up,
  :global(html:lang(ja)) .fs-heading,
  :global(html:lang(zh-CN)) .fs-heading,
  :global(html:lang(ja)) .fs-card em,
  :global(html:lang(zh-CN)) .fs-card em {
    letter-spacing: 0;
  }

  /* Under 1100 px: three stacked groups. Nothing here goes below 12 px. */
  @media (max-width: 1099.98px) {
    .flow-wide {
      display: none;
    }
    .flow-stack {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      max-width: 40rem;
      margin-inline: auto;
    }
    .fs-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .fs-heading {
      margin: 0;
      color: var(--ink-soft);
      font-size: 0.75rem;
      font-weight: 600;
    }
    .fs-card {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 12px 16px;
      border: 1.2px solid var(--ink-soft);
      border-radius: 3px;
      background: var(--paper);
      color: var(--ink);
      text-align: start;
    }
    .fs-card strong {
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.3;
    }
    .fs-card span {
      color: var(--ink-soft);
      font-size: 0.875rem;
      line-height: 1.4;
    }
    .fs-card em {
      color: var(--clay-ink);
      font-size: 0.75rem;
      font-style: normal;
      font-weight: 500;
    }
    .fs-later {
      border-style: dashed;
    }
    .fs-link {
      align-self: center;
      width: 2px;
      height: 32px;
      margin: 8px 0;
      background: var(--clay);
    }
    .fs-agent {
      align-items: center;
      text-align: center;
      gap: 4px;
    }
    .fs-agent svg {
      display: block;
    }
    .fs-agent-name {
      margin: 4px 0 0;
      color: var(--ink);
      font-size: 0.95rem;
      font-weight: 700;
    }
    .fs-verbs {
      margin: 0;
      color: var(--ink);
      font-size: 0.875rem;
      line-height: 1.4;
    }
    .fs-engineers {
      text-align: center;
    }
    .fs-people {
      display: flex;
      justify-content: center;
      gap: 20px;
    }
    .fs-people svg {
      display: block;
    }
  }
</style>
