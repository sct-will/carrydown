---
// The language control: a disclosure button with one link per locale. Each link goes to the same page in
// that locale. It works with the keyboard (Enter or Space opens it, Tab moves through the links, Escape
// closes it) and without script, because it is a native details element and plain links.
import { getStrings, localeList, locales } from '../i18n';
import { localePath, stripBase } from '../lib/paths';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const t = getStrings(locale);
const route = stripBase(Astro.url.pathname, [...locales]);
const current = localeList.find((l) => l.code === locale) ?? localeList[0];
---

<details class="control lang" data-language-menu>
  <summary>
    <span class="sr-only">{t.controls.languageLabel}: </span><span lang={current.lang}>{current.label}</span>
  </summary>
  <ul class="lang-list" role="list">
    {
      localeList.map((l) => (
        <li>
          <a
            href={localePath(l.code, route)}
            lang={l.lang}
            hreflang={l.hreflang}
            aria-current={l.code === locale ? 'true' : undefined}
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  // Close the list on Escape, on a click outside it, and when focus leaves it.
  document.querySelectorAll<HTMLDetailsElement>('details[data-language-menu]').forEach((menu) => {
    const summary = menu.querySelector('summary');
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
    menu.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (menu.open && next && !menu.contains(next)) menu.open = false;
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  });
</script>

<style>
  .lang {
    position: relative;
    display: inline-block;
    font-size: 0.85rem;
  }
  summary {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 32px 0 14px;
    border: 1px solid var(--shell-line);
    border-radius: 999px;
    background: var(--shell);
    color: var(--ink);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    position: absolute;
    inset-inline-end: 13px;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-top: -5px;
    border-inline-end: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
    transform: rotate(45deg);
    pointer-events: none;
    transition: transform var(--dur) var(--ease);
  }
  .lang[open] summary::after {
    margin-top: -1px;
    transform: rotate(225deg);
  }
  .lang-list {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 8px);
    z-index: 30;
    min-width: 100%;
    margin: 0;
    padding: 6px;
    list-style: none;
    border: 1px solid var(--shell-line);
    border-radius: 16px;
    background: var(--cream-raised);
    box-shadow: var(--shadow-lift);
  }
  .lang-list a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .lang-list a:hover {
    background: var(--teal-soft);
  }
  .lang-list a[aria-current='true'] {
    font-weight: 700;
    box-shadow: inset 3px 0 0 var(--amber);
  }
  @media (prefers-reduced-motion: reduce) {
    summary::after {
      transition: none;
    }
  }
  @media (max-width: 899.98px) {
    .lang {
      display: block;
    }
    summary {
      display: flex;
    }
    .lang-list {
      position: static;
      margin-top: 6px;
      box-shadow: none;
    }
  }
</style>
