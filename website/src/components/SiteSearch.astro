---
// The site search: a button in the header that opens a dialog with Pagefind's default UI over the index
// Starlight builds after `astro build` (dist/pagefind/). One index covers the docs and every site page,
// split by language, so a German page searches the German pages. Ctrl K or Cmd K opens it from anywhere
// on the page, and so does "/" outside a text field. `astro dev` builds no index, and the dialog says so.
// The button's name is its visible text, "Search" plus the shortcut hint where the bar shows it, so the
// name and the label never disagree. On narrow screens the word is hidden visually and the hint not at all.
import { getStrings } from '../i18n';

interface Props {
  locale?: string;
}
const s = getStrings(Astro.props.locale).search;
---

<site-search class="site-search" data-base={import.meta.env.BASE_URL} data-dev={import.meta.env.DEV ? '' : undefined}>
  <button type="button" class="search-button" aria-keyshortcuts="Control+K Meta+K" data-search-open>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"></circle>
      <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
    </svg>
    <span class="search-button__label">{s.button}</span>
    <kbd class="search-button__kbd" data-search-kbd>Ctrl K</kbd>
  </button>
  <dialog class="search-dialog" aria-labelledby="search-dialog-title" data-search-dialog>
    <div class="search-dialog__frame">
      <div class="search-dialog__head">
        <h2 class="search-dialog__title" id="search-dialog-title">{s.title}</h2>
        <button type="button" class="search-dialog__close" data-search-close>{s.close}</button>
      </div>
      <div class="search-dialog__body" data-search-mount></div>
      <p class="search-dialog__note" data-search-note hidden>{s.unavailable}</p>
    </div>
  </dialog>
</site-search>

<script>
  class SiteSearch extends HTMLElement {
    connectedCallback() {
      const open = this.querySelector<HTMLButtonElement>('[data-search-open]');
      const dialog = this.querySelector<HTMLDialogElement>('[data-search-dialog]');
      const close = this.querySelector<HTMLButtonElement>('[data-search-close]');
      const mount = this.querySelector<HTMLElement>('[data-search-mount]');
      const note = this.querySelector<HTMLElement>('[data-search-note]');
      const kbd = this.querySelector<HTMLElement>('[data-search-kbd]');
      if (!open || !dialog || !close || !mount || !note) return;
      // A browser without the dialog element gets no search button rather than a broken one.
      if (typeof dialog.showModal !== 'function') {
        open.hidden = true;
        return;
      }
      if (kbd && /Mac|iPhone|iPad|iPod/.test(navigator.platform)) kbd.textContent = '⌘ K';

      const base = (this.dataset.base ?? '/').replace(/\/$/, '');
      let loading: Promise<void> | undefined;
      const load = () => {
        if (loading) return loading;
        loading = (async () => {
          if (this.hasAttribute('data-dev')) {
            note.hidden = false;
            return;
          }
          try {
            await import('@pagefind/default-ui/css/ui.css');
            const { PagefindUI } = await import('@pagefind/default-ui');
            new PagefindUI({
              element: mount,
              baseUrl: `${base}/`,
              bundlePath: `${base}/pagefind/`,
              showImages: false,
              showSubResults: true,
              autofocus: true,
            });
          } catch {
            note.hidden = false;
          }
        })();
        return loading;
      };
      const show = async () => {
        dialog.showModal();
        await load();
        mount.querySelector<HTMLInputElement>('input')?.focus();
      };

      open.addEventListener('click', () => void show());
      close.addEventListener('click', () => dialog.close());
      // The frame covers the whole dialog box, so a click whose target is the dialog itself is on the backdrop.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', () => open.focus());

      const typing = (el: EventTarget | null) =>
        el instanceof HTMLElement && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName));
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && !e.shiftKey && !e.altKey && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (dialog.open) dialog.close();
          else void show();
        } else if (e.key === '/' && !dialog.open && !e.metaKey && !e.ctrlKey && !e.altKey && !typing(e.target)) {
          e.preventDefault();
          void show();
        }
      });
    }
  }
  customElements.define('site-search', SiteSearch);
</script>
