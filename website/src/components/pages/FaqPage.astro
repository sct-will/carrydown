---
// The questions page: two groups of questions, about the method and about carrydown, each an accordion
// of questions with a link of its own. The answers are in the page for a reader without scripts and
// for search; the script folds them, and a link to a question unfolds that one.
import SiteLayout from '../../layouts/SiteLayout.astro';
import TranslationNote from '../TranslationNote.astro';
import { getStrings } from '../../i18n';
import { localePath } from '../../lib/paths';
import '../../styles/pages.css';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const t = getStrings(locale);
const startHereUrl = `${localePath(locale, '/docs/')}#start-here`;
const f = t.faq;
// The two groups, in the order of the page. An item names its group, so a new question lands in the right place.
const sections = [
  { id: 'method', heading: f.methodHeading, items: f.items.filter((item) => item.group === 'method') },
  { id: 'carrydown', heading: f.toolHeading, items: f.items.filter((item) => item.group === 'carrydown') },
];
// The link under an answer: a site path gets the locale prefix, an address is used as written.
const href = (path: string) => (path.startsWith('/') ? localePath(locale, path) : path);
// The sign of a question's link is Starlight's link icon, the one the docs headings carry.
const anchorIcon = '<path d="m10 17.55-1.77 1.72a2.47 2.47 0 0 1-3.5-3.5l4.54-4.55a2.46 2.46 0 0 1 3.39-.09l.12.1a1 1 0 0 0 1.4-1.43 3 3 0 0 0-.18-.21 4.46 4.46 0 0 0-6.09.22l-4.6 4.55a4.48 4.48 0 0 0 6.33 6.33L11.37 19A1 1 0 0 0 10 17.55M20.69 3.31a4.49 4.49 0 0 0-6.33 0L12.63 5A1 1 0 0 0 14 6.45l1.73-1.72a2.47 2.47 0 0 1 3.5 3.5l-4.54 4.55a2.46 2.46 0 0 1-3.39.09l-.12-.1a1 1 0 0 0-1.4 1.43 3 3 0 0 0 .23.21 4.47 4.47 0 0 0 6.09-.22l4.55-4.55a4.49 4.49 0 0 0 .04-6.33"/>';
// The literal text --apply is set in monospace wherever it appears.
const parts = (text: string) => text.split('--apply');
---

<SiteLayout title={f.title} description={f.description} locale={locale} kind="faq">
  <TranslationNote locale={locale} />
  <section class="first">
    <div class="wrap">
      <h1 class="doc-title doc-title--small">{f.h1}</h1>
      <p class="page-intro">{f.intro}</p>
      {
        sections.map((section) => (
          <section class="faq-section" aria-labelledby={`faq-${section.id}`}>
            <h2 class="page-h2" id={`faq-${section.id}`}>{section.heading}</h2>
            <div class="faq">
              {section.items.map((item) => (
                <div class="faq-item" id={item.id}>
                  <h3 class="faq-q">
                    <button type="button" class="faq-toggle" aria-expanded="true" aria-controls={`${item.id}-answer`}>
                      <span class="faq-q-text">{item.q}</span>
                      <svg class="faq-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                        <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </button>
                    <a class="faq-anchor-link" href={`#${item.id}`} aria-label={f.anchorLabel}>
                      <svg class="faq-anchor" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={anchorIcon}></svg>
                    </a>
                  </h3>
                  <div class="faq-panel" id={`${item.id}-answer`}>
                    <p class="faq-a">{item.a}</p>
                    {'list' in item && item.list && (
                      <ul class="faq-list">
                        {item.list.map((fact) => {
                          const [before, ...after] = parts(fact);
                          return (
                            <li>
                              {before}
                              {after.length > 0 && (
                                <>
                                  <span class="mono">--apply</span>
                                  {after.join('--apply')}
                                </>
                              )}
                            </li>
                          );
                        })}
                      </ul>
                    )}
                    {'more' in item && item.more && (
                      <p class="faq-more">
                        <a href={href(item.more.href)}>{item.more.label}</a>
                      </p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))
      }
      <p class="page-action"><a class="btn primary" href={startHereUrl}>{t.home.buttons.try}</a></p>
    </div>
  </section>
</SiteLayout>

<script>
  // The accordion. Each question is a button that shows or hides its answer. A link to a question, in the
  // address or on the page, unfolds that question and scrolls to it.
  const items = Array.from(document.querySelectorAll<HTMLElement>('.faq-item'));
  const set = (item: HTMLElement, open: boolean) => {
    const toggle = item.querySelector<HTMLButtonElement>('.faq-toggle');
    const panel = item.querySelector<HTMLElement>('.faq-panel');
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
  };
  const current = () => decodeURIComponent(location.hash.slice(1));
  const openHash = () => {
    const item = items.find((i) => i.id === current());
    if (!item) return;
    set(item, true);
    item.scrollIntoView();
  };
  items.forEach((item) => {
    set(item, item.id === current());
    item.querySelector<HTMLButtonElement>('.faq-toggle')?.addEventListener('click', (event) => {
      set(item, (event.currentTarget as HTMLButtonElement).getAttribute('aria-expanded') !== 'true');
    });
    item.querySelector<HTMLAnchorElement>('.faq-anchor-link')?.addEventListener('click', () => set(item, true));
  });
  window.addEventListener('hashchange', openHash);
  openHash();
</script>
