---
// The questions page: the questions, each with a link of its own, and the facts about what carrydown
// does not do.
import SiteLayout from '../../layouts/SiteLayout.astro';
import TranslationNote from '../TranslationNote.astro';
import { getStrings } from '../../i18n';
import { localePath } from '../../lib/paths';
import '../../styles/pages.css';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const t = getStrings(locale);
const startHereUrl = `${localePath(locale, '/docs/')}#start-here`;
const f = t.faq;
// The link under an answer: a site path gets the locale prefix, an address is used as written.
const href = (path: string) => (path.startsWith('/') ? localePath(locale, path) : path);
// The sign of a question's link is Starlight's link icon, the one the docs headings carry.
const anchorIcon = '<path d="m10 17.55-1.77 1.72a2.47 2.47 0 0 1-3.5-3.5l4.54-4.55a2.46 2.46 0 0 1 3.39-.09l.12.1a1 1 0 0 0 1.4-1.43 3 3 0 0 0-.18-.21 4.46 4.46 0 0 0-6.09.22l-4.6 4.55a4.48 4.48 0 0 0 6.33 6.33L11.37 19A1 1 0 0 0 10 17.55M20.69 3.31a4.49 4.49 0 0 0-6.33 0L12.63 5A1 1 0 0 0 14 6.45l1.73-1.72a2.47 2.47 0 0 1 3.5 3.5l-4.54 4.55a2.46 2.46 0 0 1-3.39.09l-.12-.1a1 1 0 0 0-1.4 1.43 3 3 0 0 0 .23.21 4.47 4.47 0 0 0 6.09-.22l4.55-4.55a4.49 4.49 0 0 0 .04-6.33"/>';
// The literal text --apply is set in monospace wherever it appears.
const parts = (text: string) => text.split('--apply');
---

<SiteLayout title={f.title} description={f.description} locale={locale} kind="faq">
  <TranslationNote locale={locale} />
  <section class="first">
    <div class="wrap">
      <h1 class="doc-title doc-title--small">{f.h1}</h1>
      <p class="page-intro">{f.intro}</p>
      <div class="faq">
        {
          f.items.map((item) => (
            <div class="faq-item">
              <h2 class="faq-q" id={item.id}>
                <a href={`#${item.id}`}>
                  {item.q}
                  <svg class="faq-anchor" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={anchorIcon}></svg>
                </a>
              </h2>
              <p class="faq-a">{item.a}</p>
              {'more' in item && item.more && (
                <p class="faq-more">
                  <a href={href(item.more.href)}>{item.more.label}</a>
                </p>
              )}
            </div>
          ))
        }
      </div>
      <h2 class="page-h2">{f.doesNotHeading}</h2>
      <ul class="factgrid" role="list">
        {
          f.doesNot.map((fact) => {
            const [before, ...after] = parts(fact);
            return (
              <li class="fact">
                {before}
                {after.length > 0 && (
                  <>
                    <span class="mono">--apply</span>
                    {after.join('--apply')}
                  </>
                )}
              </li>
            );
          })
        }
      </ul>
      <p class="page-action"><a class="btn primary" href={startHereUrl}>{t.home.buttons.try}</a></p>
    </div>
  </section>
</SiteLayout>
