---
// The home page body, shared by the English page and every translated page.
import SiteLayout from '../../layouts/SiteLayout.astro';
import HowItWorks from '../HowItWorks.astro';
import TranslationNote from '../TranslationNote.astro';
import { getStrings } from '../../i18n';
import { localePath } from '../../lib/paths';
import { repoUrl, sampleBoardUrl } from '../../../site.config.mjs';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const t = getStrings(locale);
const h = t.home;
const c = h.carrydown;
const tileLinks = [
  sampleBoardUrl,
  localePath(locale, '/docs/plan-owner-guide/'),
  localePath(locale, '/docs/setup/'),
];
---

<SiteLayout title={h.title} description={h.description} locale={locale} kind="home">
  <TranslationNote locale={locale} />
  <section class="first center">
    <div class="wrap">
      <h1 class="r25">{h.h1}</h1>
      <p class="defn">{h.definition}</p>
      <p class="sub">{h.paragraph}</p>
      <div class="actions">
        <a class="btn primary" href={repoUrl}>{h.buttons.try}</a>
        <a class="btn secondary" href={sampleBoardUrl}>{h.buttons.sample}</a>
      </div>

      <h2 class="how">{h.howHeading}</h2>
      <HowItWorks locale={locale} />

      <div class="stmt">
        <h2>{h.statement.heading}</h2>
        <p>{h.statement.body}</p>
      </div>
      <div class="vals">
        {h.values.map((v) => (
          <div>
            <span class="eb">{v.eyebrow}</span>
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="carrydown">
    <div class="wrap">
      <h2 class="cd-h">{c.headingBefore}<span class="accent">{c.headingBrand}</span>{c.headingAfter}</h2>
      <p class="cd-intro">{c.intro}</p>
      <div class="cd-cta">
        <a class="btn primary" href={repoUrl}>{c.tryButton}</a>
        <div class="cmd">
          <code id="install-command">{c.installCommand}</code>
          <button
            type="button"
            class="copy"
            aria-label={c.copyLabel}
            data-copy-target="install-command"
            data-label={c.copy}
            data-copied={c.copied}
            data-ok={c.copiedStatus}
            data-fail={c.copyFailedStatus}
          >{c.copy}</button>
        </div>
        <span class="sr-only" role="status" data-copy-status></span>
      </div>
      <p class="caption">{c.needs}</p>

      <div class="tiles">
        {c.tiles.map((tile, i) => (
          <div class="tile">
            <div class="n">{tile.step}</div>
            <h3>{tile.title}</h3>
            <p>{tile.body}{tile.command && <>{' '}<span class="mono">{tile.command}</span></>}</p>
            <a class="btn secondary" href={tileLinks[i]}>{tile.button}</a>
            <div class="time">{tile.time}</div>
          </div>
        ))}
      </div>

      <h3 class="cd-sub">{c.stepsHeading}</h3>
      <ol class="runsteps" role="list">
        {c.steps.map((s, i) => (
          <li class="rs">
            <div class="rs-n">{i + 1}</div>
            <div class="rs-who">{s.who}</div>
            <div class="rs-body">
              <div class="rs-what">{s.what}</div>
              {s.say ? (
                <div class="rs-say">{s.say}</div>
              ) : (
                <div class="rs-say">
                  <span class="dash" aria-hidden="true"></span>
                  <span class="sr-only">{c.noCommand}</span>
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</SiteLayout>

<script>
  // The Copy button writes the install command to the clipboard and says so in a live region.
  document.querySelectorAll<HTMLButtonElement>('button[data-copy-target]').forEach((button) => {
    const target = document.getElementById(button.dataset.copyTarget ?? '');
    const status = button.parentElement?.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      const text = target?.textContent?.trim() ?? '';
      let ok = false;
      try {
        await navigator.clipboard.writeText(text);
        ok = true;
      } catch {
        // Fallback for pages without the async clipboard (older browsers, insecure origins).
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        area.remove();
        button.focus();
      }
      if (status) {
        // Clear first so a repeat click is announced again.
        status.textContent = '';
        window.setTimeout(() => {
          status.textContent = ok ? (button.dataset.ok ?? '') : (button.dataset.fail ?? '');
        }, 50);
      }
      if (ok) {
        button.textContent = button.dataset.copied ?? '';
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          button.textContent = button.dataset.label ?? '';
        }, 2000);
      }
    });
  });
</script>
