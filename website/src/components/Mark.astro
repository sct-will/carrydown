---
// The mark: three rounded bars with one channel cut through them, the path context takes from the plan
// through the work to the engineer's agent. The channel is a mask, so it shows the ground behind the
// mark and the one drawing reads on cream and on navy; the bars take the theme's teal. The geometry is
// the master file src/assets/logo/mark.svg. It is decorative: the words next to it carry the name.
interface Props {
  /** The height in pixels. The mark is wider than tall, 931 by 777 units. */
  size?: number;
}
const { size = 24 } = Astro.props;
const width = Math.round((size * 931) / 777);
const id = `mark-cut-${size}`;
---

<svg
  class="mark"
  width={width}
  height={size}
  viewBox="161 240 931 777"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <mask id={id} maskUnits="userSpaceOnUse" x="0" y="0" width="1254" height="1254">
      <rect width="1254" height="1254" fill="#fff"></rect>
      <rect x="313" y="481" width="160" height="250" rx="14" fill="#000"></rect>
      <path d="M440 699H590C640 699 640 538 690 538H1100" fill="none" stroke="#000" stroke-width="66"></path>
    </mask>
  </defs>
  <g mask={`url(#${id})`}>
    <rect x="173" y="252" width="296" height="753" rx="64"></rect>
    <rect x="482" y="252" width="287" height="753" rx="64"></rect>
    <rect x="782" y="252" width="298" height="753" rx="64"></rect>
  </g>
</svg>

<style>
  .mark {
    display: block;
    flex: none;
  }
  .mark g {
    fill: var(--teal);
  }
</style>
