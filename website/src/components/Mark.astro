---
// The "Pinned pages" mark (logo concept I). Two pages held by one amber line that continues down.
// Drawn with the theme tokens so it reads on cream and on navy. It is decorative: the words next to it
// carry the name.
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg
  class="mark"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <rect x="14" y="10" width="26" height="34" rx="3" stroke-width="4"></rect>
  <rect x="24" y="20" width="26" height="34" rx="3" stroke-width="4"></rect>
  <path class="thread" d="M37 4 V60" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
  <circle class="bead" cx="37" cy="60" r="4"></circle>
</svg>

<style>
  .mark {
    display: block;
    flex: none;
  }
  .mark rect {
    stroke: var(--ink);
    fill: var(--cream);
  }
  .mark .thread {
    stroke: var(--amber);
  }
  .mark .bead {
    fill: var(--amber);
  }
</style>
