---
import { getStrings } from '../i18n';
interface Props {
  locale?: string;
}
const t = getStrings(Astro.props.locale).controls;
---

<div class="control select">
  <label class="sr-only" for="theme-select">{t.themeLabel}</label>
  <select id="theme-select" data-theme-select>
    <option value="auto" selected>{t.themeAuto}</option>
    <option value="dark">{t.themeDark}</option>
    <option value="light">{t.themeLight}</option>
  </select>
</div>

<script>
  // Auto is the default. The choice is kept in localStorage under "cc-theme" and mirrored on <html> as
  // data-theme. Auto removes both, so the system preference decides.
  const KEY = 'cc-theme';
  const root = document.documentElement;

  function stored(): string {
    try {
      const v = localStorage.getItem(KEY);
      return v === 'dark' || v === 'light' ? v : 'auto';
    } catch {
      return 'auto';
    }
  }

  function apply(value: string) {
    if (value === 'dark' || value === 'light') root.dataset.theme = value;
    else delete root.dataset.theme;
  }

  document.querySelectorAll<HTMLSelectElement>('select[data-theme-select]').forEach((select) => {
    select.value = stored();
    select.addEventListener('change', () => {
      const value = select.value;
      try {
        if (value === 'auto') localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, value);
      } catch {
        /* Storage can be blocked. The choice still applies to this page view. */
      }
      apply(value);
      document
        .querySelectorAll<HTMLSelectElement>('select[data-theme-select]')
        .forEach((s) => (s.value = value));
    });
  });
</script>
