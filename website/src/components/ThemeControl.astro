---
import { getStrings } from '../i18n';
interface Props {
  locale?: string;
}
const t = getStrings(Astro.props.locale).controls;
---

<div class="control select">
  <label class="sr-only" for="theme-select">{t.themeLabel}</label>
  <select id="theme-select" data-theme-select>
    <option value="light" selected>{t.themeLight}</option>
    <option value="dark">{t.themeDark}</option>
    <option value="auto">{t.themeAuto}</option>
  </select>
</div>

<script>
  // Light is the default. The choice is kept in localStorage under "cc-theme" and mirrored on <html> as
  // data-theme-choice; data-theme carries the theme it resolves to, as ThemeScript sets it before first
  // paint. A change crossfades the colors for a moment, unless the visitor prefers reduced motion.
  const KEY = 'cc-theme';
  const root = document.documentElement;
  const dark = window.matchMedia('(prefers-color-scheme: dark)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  function stored(): string {
    try {
      const v = localStorage.getItem(KEY);
      return v === 'dark' || v === 'auto' ? v : 'light';
    } catch {
      return 'light';
    }
  }

  let fade: number | undefined;
  function apply(value: string) {
    root.dataset.themeChoice = value;
    const next = value === 'auto' ? (dark.matches ? 'dark' : 'light') : value;
    if (next !== root.dataset.theme && !reduce.matches) {
      root.classList.add('theme-fade');
      window.clearTimeout(fade);
      fade = window.setTimeout(() => root.classList.remove('theme-fade'), 500);
    }
    root.dataset.theme = next;
  }

  document.querySelectorAll<HTMLSelectElement>('select[data-theme-select]').forEach((select) => {
    select.value = stored();
    select.addEventListener('change', () => {
      const value = select.value;
      try {
        if (value === 'light') localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, value);
      } catch {
        /* Storage can be blocked. The choice still applies to this page view. */
      }
      apply(value);
      document
        .querySelectorAll<HTMLSelectElement>('select[data-theme-select]')
        .forEach((s) => (s.value = value));
    });
  });
</script>
