---
// Runs before first paint. The site has one theme, light: the script holds data-theme="light" on <html>,
// which Starlight's styles read, and marks the page as script-enabled, which the narrow-screen menu and
// the motion need. The build writes the same data-theme into every page (see astro.config.mjs), so a
// page without script is light as well.
//
// It also guards the page transition (chrome.css opts every page into a cross-document view
// transition): a transition still unfinished 600 ms after this script ran is skipped. A healthy one
// takes 200 ms. An embedded or automated browser can hold a transition for seconds, and while it holds
// it the page's own animations wait, so the guard keeps a stalled transition from holding the page.
---

<script is:inline>
  (function () {
    var d = document.documentElement;
    d.classList.add('js');
    d.dataset.theme = 'light';
    setTimeout(function () {
      var vt = document.activeViewTransition;
      if (vt) vt.skipTransition();
    }, 600);
  })();
</script>
