---
// The translated faq page. One file serves every non-English locale: /de/, /fr/, /ja/, /es/,
// /pt-br/ and /zh-cn/.
import FaqPage from '../../components/pages/FaqPage.astro';
import { translatedLocales } from '../../i18n';

export function getStaticPaths() {
  return translatedLocales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
---

<FaqPage locale={locale} />
